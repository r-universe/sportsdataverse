[submodule ".registry"]
	path = .registry
	url = https://github.com/sportsdataverse/sportsdataverse.r-universe.dev
	branch = HEAD
[submodule "baseballr"]
	path = baseballr
	url = https://github.com/BillPetti/baseballr
